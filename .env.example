# --- Servidor ---
NODE_ENV=development
PORT=3000
# Número de saltos de proxy confiables (Render / Railway / Cloudflare = 1)
TRUST_PROXY=1
# Orígenes permitidos por CORS (separados por coma). Estricto, con credenciales.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# URL pública del frontend sin diagonal final (para construir el enlace /invitacion/<token>)
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL (Supabase / Docker) ---
# Para Supabase usar Session Pooler (puerto 5432, sin ?sslmode=require) y DATABASE_SSL=true
DATABASE_URL=postgresql://secdocs:secdocs_dev_pass@localhost:5432/secdocs
DATABASE_SSL=false
# Solo docker compose local: contraseña del usuario de PostgreSQL
POSTGRES_PASSWORD=secdocs_dev_pass

# --- Criptografía ---
# Master Key (MEK): 32 bytes en hex (64 chars) o base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=
# Secreto para firmar JWT (>= 32 chars aleatorios)
JWT_SECRET=
JWT_EXPIRES_HOURS=8
# Nombre de la cookie de sesión (HttpOnly, SameSite=Strict, Secure en producción)
COOKIE_NAME=secdocs_session
# Máximo de intentos por IP cada 15 min en /auth/register y /auth/login
AUTH_RATE_LIMIT_MAX=20
# Máximo de solicitudes por IP cada 15 min en /invitations/* y /shared/*
INVITATION_RATE_LIMIT_MAX=60
# Cooldown entre reenvíos de la clave Canal 2 (verify-identity)
PASSWORD_RESEND_COOLDOWN_SECONDS=60

# --- Almacenamiento de binarios cifrados ---
# r2 = Cloudflare R2 (principal). local = disco, SOLO pruebas locales (se rechaza en producción)
STORAGE_DRIVER=r2
STORAGE_LOCAL_DIR=.storage-local

# --- Cloudflare R2 (compatible S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=secdocs
# Opcional: si se omite se usa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Subidas y bóvedas ---
# Tamaño máximo por archivo (413 si se excede)
MAX_FILE_SIZE_MB=15
# Tope de vigencia al crear una bóveda (días desde ahora)
VAULT_MAX_DAYS=365

# --- Correo SMTP (Canal 2) ---
# Si SMTP_HOST está vacío en desarrollo, solo se registra en consola que se envió
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SecDocs <no-reply@secdocs.local>"
