# Copia este archivo a .env y reemplaza los valores. Nunca subas .env a git.
PORT=4000
DATABASE_URL=postgres://secdocs:CAMBIAR@localhost:5432/secdocs
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=CAMBIAR
# 32 bytes en base64. Genera uno con: openssl rand -base64 32
MASTER_KEY_V1=CAMBIAR
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=true
TRUST_PROXY=1
STORAGE_DIR=./data/vault
MAX_UPLOAD_MB=25
# Ruta a schema/schema.sql del repositorio SecDocs-DB (para npm run migrate)
SCHEMA_PATH=../SecDocs-DB/schema/schema.sql
